{
  "expo": {
    "name": "WBWday",
    "slug": "jinri-liyuan",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "wbwday",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.wang.wbwday",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0081FF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "允许 WBWday 使用麦克风，用于把你的语音转成文字。",
          "speechRecognitionPermission": "允许 WBWday 使用语音识别，用于把你的语音转成文字。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允许 WBWday 获取当前位置，用于显示本地天气。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 WBWday 访问相册，用于选择还愿照片。",
          "cameraPermission": "允许 WBWday 使用相机，用于拍照还愿。",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4269d2c-8a28-4bc6-9b06-39d266aa0370"
      }
    },
    "owner": "laoliu276"
  }
}
